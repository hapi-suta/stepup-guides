{
  "1": {
    "type": "manual",
    "hint": "ls /usr/edb/as16/bin - see the EPAS binaries."
  },
  "2": {
    "type": "manual",
    "hint": "grep port in postgresql.conf - see 5444."
  },
  "3": {
    "type": "manual",
    "hint": "sudo su - enterprisedb."
  },
  "4": {
    "type": "ssh",
    "check": "sudo -u enterprisedb /usr/edb/as16/bin/edb-psql -p 5444 -d edb -Atc \"SELECT true\" | grep -qx t",
    "hint": "psql -p 5444 -d edb."
  },
  "5": {
    "type": "manual",
    "hint": "SHOW shared_buffers;"
  },
  "6": {
    "type": "manual",
    "hint": "SHOW data_directory;"
  },
  "7": {
    "type": "manual",
    "hint": "SELECT count(*) FROM user_tables;"
  },
  "8": {
    "type": "manual",
    "hint": "SELECT table_name FROM user_tables;"
  },
  "9": {
    "type": "ssh",
    "check": "sudo -u enterprisedb /usr/edb/as16/bin/edb-psql -p 5444 -d edb -Atc \"SELECT (to_regclass('card_auth_test') IS NOT NULL)\" | grep -qx t",
    "hint": "CREATE TABLE card_auth_test (...)."
  },
  "10": {
    "type": "ssh",
    "check": "sudo -u enterprisedb /usr/edb/as16/bin/edb-psql -p 5444 -d edb -Atc \"SELECT ((SELECT count(*)>=1 FROM card_auth_test))\" | grep -qx t",
    "hint": "INSERT a row into card_auth_test."
  },
  "11": {
    "type": "manual",
    "hint": "SELECT table_name ... WHERE table_name='CARD_AUTH_TEST' - confirm it exists."
  },
  "12": {
    "type": "ssh",
    "check": "sudo -u enterprisedb /usr/edb/as16/bin/edb-psql -p 5444 -d edb -Atc \"SELECT (to_regclass('card_auth_test') IS NULL)\" | grep -qx t",
    "hint": "DROP TABLE card_auth_test."
  },
  "13": {
    "type": "manual",
    "hint": "\\l - list databases."
  },
  "14": {
    "type": "manual",
    "hint": "\\q."
  },
  "15": {
    "type": "manual",
    "hint": "exit back to ec2-user."
  },
  "16": {
    "type": "ssh",
    "check": "systemctl is-active edb-as-16 | grep -qxv active",
    "hint": "sudo systemctl stop edb-as-16."
  },
  "17": {
    "type": "manual",
    "hint": "ss -tlnp | grep 5444 - nothing listening now."
  },
  "18": {
    "type": "ssh",
    "check": "systemctl is-active edb-as-16 | grep -qx active",
    "hint": "sudo systemctl start edb-as-16."
  },
  "19": {
    "type": "manual",
    "hint": "sudo systemctl status edb-as-16 - active again."
  },
  "20": {
    "type": "manual",
    "hint": "sudo ls the log directory."
  },
  "21": {
    "type": "manual",
    "hint": "tail the newest log file."
  },
  "22": {
    "type": "manual",
    "hint": "status + ss - confirm back up on 5444."
  },
  "23": {
    "type": "manual",
    "hint": "sudo su - enterprisedb."
  },
  "24": {
    "type": "manual",
    "hint": "SELECT version()/sysdate - confirm reachable."
  },
  "25": {
    "type": "manual",
    "hint": "exit."
  },
  "26": {
    "type": "manual",
    "hint": "tail the log once more."
  }
