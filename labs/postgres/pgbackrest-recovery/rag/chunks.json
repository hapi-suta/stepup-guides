      "concept": "asynchronous archive",
      "failure_codes": [],
      "source_url": "https://pgbackrest.org/configuration.html",
      "source_type": "official",
      "reviewed_at": "2026-09-07",
      "content_hash": "sha256:8847228c2336660aea9379e128e6c7ae01f3e7c4b4b9f975419bdc864a1b4c96",
      "content": "Asynchronous archiving uses local spool state and can reuse connections and parallel workers. A configured archive-push queue limit can discard WAL after reporting success, breaking PITR continuity. Do not treat that limit as a harmless performance knob."
    },
