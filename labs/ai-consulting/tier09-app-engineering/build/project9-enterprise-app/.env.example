# Copy to .env and fill in. NEVER commit the real .env.
# The app and worker read ALL config from these variables (12-factor).

# --- Database (the lab defaults) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=labdb
DB_USER=labuser
DB_PASSWORD=labpass

# --- Connection pool sizing ---
# maxconn must stay well below PostgreSQL's max_connections.
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=5

# --- Sessions ---
SESSION_TTL_HOURS=8

# --- SSO / OIDC ---
# mock: /login accepts an email directly (class box, no identity provider).
# real: exchange an OIDC authorization code and read the verified email claim.
OIDC_MODE=mock
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret

# --- LLM generation ---
# LEAVE BLANK to run with the offline MOCK generator (no cost, no network).
# Set a real key ONLY when you want Claude to write the answers.
# ANTHROPIC_API_KEY=sk-ant-...
