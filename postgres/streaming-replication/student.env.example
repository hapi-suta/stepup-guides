# Copy this to your labs root as student.env and fill in your server IPs.
# Happy will give you the IPs after provisioning.

STUDENT_ID="your-name"
STUDENT_NAME="Your Name"
STUDENT_PHONE="+1XXXXXXXXXX"
STUDENT_EMAIL="you@example.com"

# Server IPs (from Happy)
NODE1=""    # primary
NODE2=""    # standby

# SSH
SSH_USER="root"
SSH_KEY="~/.ssh/id_ed25519"

# PostgreSQL
PG_VERSION="16"
PG_PORT=5432
PG_USER="postgres"
PG_DB="labdb"
