--- Check 5: Prometheus config ---
$ cat /opt/prometheus/prometheus.yml
global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - localhost:9093

rule_files:
  - alert_rules.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
      - targets:
          - 172.31.19.86:9100
          - 172.31.22.69:9100
          - 172.31.21.45:9100
          - 172.31.26.19:9100
        labels:
          cluster: voleon-lab

  - job_name: postgres
    static_configs:
      - targets:
          - 172.31.19.86:9187
          - 172.31.22.69:9187
        labels:
          cluster: voleon-lab

  - job_name: alertmanager
    static_configs:
      - targets: ['localhost:9093']

